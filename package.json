{
  "name": "vitalcampus-monorepo",
  "version": "1.0.0",
  "description": "VitalCampus V 1.0 - Plataforma de bienestar para estudiantes universitarios",
  "private": true,
  "scripts": {
    "install:all": "npm run install:backend && npm run install:frontend",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run start",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:push": "npm --prefix backend run prisma:push",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "prisma:seed": "npm --prefix backend run seed",
    "seed": "npm --prefix backend run seed"
  },
  "keywords": [
    "vitalcampus",
    "angular",
    "nodejs",
    "express",
    "typescript",
    "prisma",
    "sqlite"
  ],
  "author": "VitalCampus Team",
  "license": "ISC"
}
